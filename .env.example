GROQ_API_KEY=your_groq_key_here
MODEL=openai/gpt-oss-120b

# 1 = create the demo accounts on start (alice, bob, hana, dev, rita)
SEED_DEMO=1
# demo password; default is demo1234 if you leave this out. Set something private for a public server.
DEMO_PASSWORD=

# Plain HTTP on the server IP:
SITE_ADDRESS=:80
COOKIE_SECURE=0
# With a domain + HTTPS, use instead:
# SITE_ADDRESS=demo.yourdomain.com
# COOKIE_SECURE=1
